## Remote Datasource Creation

### Location
`lib/data/datasources/remote/{feature}_remote_datasource.dart`

### Abstract Interface Template

```dart
import 'package:flutter_finance_assistant/data/models/{feature}_model.dart';

/// Remote datasource for {Feature} operations with Firebase.
abstract class FeatureRemoteDataSource {
  /// Get all features for a user.
  Future<List<FeatureModel>> getFeatures(String userId);

  /// Get feature by ID.
  Future<FeatureModel?> getFeatureById(String userId, String featureId);

  /// Create a new feature.
  Future<FeatureModel> createFeature(String userId, FeatureModel feature);

  /// Update an existing feature.
  Future<FeatureModel> updateFeature(String userId, FeatureModel feature);

  /// Delete a feature.
  Future<void> deleteFeature(String userId, String featureId);

  /// Stream all features for a user.
  Stream<List<FeatureModel>> watchFeatures(String userId);
}
```

### Implementation Template

```dart
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter_finance_assistant/core/errors/exceptions.dart';
import 'package:flutter_finance_assistant/data/datasources/remote/firebase_service.dart';
import 'package:flutter_finance_assistant/data/models/{feature}_model.dart';

/// Implementation of [FeatureRemoteDataSource] using Firebase Firestore.
class FeatureRemoteDataSourceImpl implements FeatureRemoteDataSource {
  final FirebaseService _firebaseService;

  FeatureRemoteDataSourceImpl({required FirebaseService firebaseService})
      : _firebaseService = firebaseService;

  @override
  Future<List<FeatureModel>> getFeatures(String userId) async {
    return _firebaseService.handleFirestoreOperation(
      () async {
        final snapshot = await _firebaseService
            .featuresCollection(userId)
            .orderBy('created_at', descending: true)
            .get();

        return snapshot.docs
            .map((doc) => FeatureModel.fromFirestore(doc.data(), doc.id))
            .toList();
      },
      operationName: 'get features',
    );
  }

  @override
  Future<FeatureModel?> getFeatureById(String userId, String featureId) async {
    return _firebaseService.handleFirestoreOperation(
      () async {
        final doc = await _firebaseService
            .featuresCollection(userId)
            .doc(featureId)
            .get();

        if (!doc.exists || doc.data() == null) {
          return null;
        }

        return FeatureModel.fromFirestore(doc.data()!, doc.id);
      },
      operationName: 'get feature',
    );
  }

  @override
  Future<FeatureModel> createFeature(String userId, FeatureModel feature) async {
    return _firebaseService.handleFirestoreOperation(
      () async {
        final docRef = _firebaseService.featuresCollection(userId).doc(feature.id);

        await docRef.set({
          ...feature.toFirestore(),
          'created_at': FieldValue.serverTimestamp(),
          'updated_at': FieldValue.serverTimestamp(),
        });

        final doc = await docRef.get();
        return FeatureModel.fromFirestore(doc.data()!, doc.id);
      },
      operationName: 'create feature',
    );
  }

  @override
  Future<FeatureModel> updateFeature(String userId, FeatureModel feature) async {
    return _firebaseService.handleFirestoreOperation(
      () async {
        final docRef = _firebaseService.featuresCollection(userId).doc(feature.id);

        await docRef.update({
          ...feature.toFirestore(),
          'updated_at': FieldValue.serverTimestamp(),
        });

        final doc = await docRef.get();
        if (!doc.exists || doc.data() == null) {
          throw NotFoundException('Feature not found after update');
        }

        return FeatureModel.fromFirestore(doc.data()!, doc.id);
      },
      operationName: 'update feature',
    );
  }

  @override
  Future<void> deleteFeature(String userId, String featureId) async {
    return _firebaseService.handleFirestoreOperation(
      () async {
        await _firebaseService
            .featuresCollection(userId)
            .doc(featureId)
            .delete();
      },
      operationName: 'delete feature',
    );
  }

  @override
  Stream<List<FeatureModel>> watchFeatures(String userId) {
    return _firebaseService
        .featuresCollection(userId)
        .orderBy('created_at', descending: true)
        .snapshots()
        .map((snapshot) => snapshot.docs
            .map((doc) => FeatureModel.fromFirestore(doc.data(), doc.id))
            .toList());
  }
}
```

### Remote Datasource Rules
1. Always use `FirebaseService.handleFirestoreOperation()` for error handling
2. Use `FieldValue.serverTimestamp()` for created_at/updated_at timestamps
3. All user data should be stored in user subcollections (`users/{userId}/{collection}`)
4. Return `Model` types, not `Entity` types
5. Use `Model.fromFirestore()` and `Model.toFirestore()` for serialization
6. Provide both `Future` methods and `Stream` methods where applicable
7. Document all methods with `///` comments

### After Creating Remote Datasource
1. Add collection reference to `firebase_service.dart`:
```dart
CollectionReference<Map<String, dynamic>> featuresCollection(String userId) =>
    _firestore
        .collection(AppConstants.usersCollection)
        .doc(userId)
        .collection(AppConstants.featuresCollection);
```

2. Add export to `remote/remote.dart`:
```dart
export 'feature_remote_datasource.dart';
```

