## Model Creation

### Location
`lib/data/models/{feature}_model.dart`

### Template

```dart
import 'package:json_annotation/json_annotation.dart';
import 'package:flutter_finance_assistant/domain/entities/{feature}.dart';

part '{feature}_model.g.dart';

@JsonSerializable()
class FeatureModel {
  final String id;
  final String name;
  final double amount;
  
  @JsonKey(name: 'created_at')
  final DateTime createdAt;

  const FeatureModel({
    required this.id,
    required this.name,
    required this.amount,
    required this.createdAt,
  });

  /// Create from JSON
  factory FeatureModel.fromJson(Map<String, dynamic> json) =>
      _$FeatureModelFromJson(json);

  /// Convert to JSON
  Map<String, dynamic> toJson() => _$FeatureModelToJson(this);

  /// Convert to domain entity
  Feature toEntity() => Feature(
        id: id,
        name: name,
        amount: amount,
        createdAt: createdAt,
      );

  /// Create from domain entity
  factory FeatureModel.fromEntity(Feature entity) => FeatureModel(
        id: entity.id,
        name: entity.name,
        amount: entity.amount,
        createdAt: entity.createdAt,
      );
  
  /// Create from Firestore document
  factory FeatureModel.fromFirestore(Map<String, dynamic> data, String id) {
    return FeatureModel(
      id: id,
      name: data['name'] as String,
      amount: (data['amount'] as num).toDouble(),
      createdAt: (data['created_at'] as Timestamp).toDate(),
    );
  }

  /// Convert to Firestore document
  Map<String, dynamic> toFirestore() {
    return {
      'name': name,
      'amount': amount,
      'created_at': Timestamp.fromDate(createdAt),
    };
  }
}
```

### After Creating Model
Run build_runner to generate serialization code:
```bash
dart run build_runner build --delete-conflicting-outputs
```

