Future<void> initDependencies() async {
  // ═══════════════════════════════════════════════════════════════════════════
  // CORE - External Services & Database
  // ═══════════════════════════════════════════════════════════════════════════
  sl.registerLazySingleton<AppDatabase>(() => AppDatabase());
  sl.registerLazySingleton<FirebaseService>(() => FirebaseService());

