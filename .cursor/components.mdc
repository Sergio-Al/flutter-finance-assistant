## DAO Creation

### Location
`lib/data/datasources/local/daos/{feature}_dao.dart`

### Template

```dart
import 'package:drift/drift.dart';
import '../app_database.dart';
import '../tables/tables.dart';

part '{feature}_dao.g.dart';

@DriftAccessor(tables: [Features])
class FeaturesDao extends DatabaseAccessor<AppDatabase> with _$FeaturesDaoMixin {
  FeaturesDao(super.db);

  // ==================== CRUD ====================

  /// Get feature by ID
  Future<Feature?> getFeatureById(String id) {
    return (select(features)..where((t) => t.id.equals(id))).getSingleOrNull();
  }

  /// Get all features
  Future<List<Feature>> getAllFeatures() {
    return select(features).get();
  }

  /// Get features by user
  Future<List<Feature>> getFeaturesByUser(String userId) {
    return (select(features)..where((t) => t.userId.equals(userId))).get();
  }

  /// Insert new feature
  Future<void> insertFeature(FeaturesCompanion feature) {
    return into(features).insert(feature);
  }

  /// Update feature
  Future<void> updateFeature(FeaturesCompanion feature) {
    return (update(features)..where((t) => t.id.equals(feature.id.value)))
        .write(feature);
  }

  /// Delete feature
  Future<void> deleteFeature(String id) {
    return (delete(features)..where((t) => t.id.equals(id))).go();
  }

  // ==================== Queries ====================

  /// Get active features
  Future<List<Feature>> getActiveFeatures(String userId) {
    return (select(features)
          ..where((t) => t.userId.equals(userId) & t.isActive.equals(true))
          ..orderBy([(t) => OrderingTerm.desc(t.createdAt)]))
        .get();
  }

  // ==================== Reactive Streams ====================

  /// Watch features by user
  Stream<List<Feature>> watchFeaturesByUser(String userId) {
    return (select(features)
          ..where((t) => t.userId.equals(userId))
          ..orderBy([(t) => OrderingTerm.desc(t.createdAt)]))
        .watch();
  }

  // ==================== Sync ====================

  /// Update sync status
  Future<void> updateSyncStatus(String id, String status) {
    return (update(features)..where((t) => t.id.equals(id))).write(
      FeaturesCompanion(
        syncStatus: Value(status),
        updatedAt: Value(DateTime.now().millisecondsSinceEpoch),
      ),
    );
  }

  /// Get pending sync items
  Future<List<Feature>> getPendingSync() {
    return (select(features)
          ..where((t) => t.syncStatus.equals('pending')))
        .get();
  }
}
```

### DAO Rules
1. Always extend `DatabaseAccessor<AppDatabase>`
2. Use `_$FeaturesDaoMixin` from generated code
3. Tables accessed via lowercase plurals (e.g., `features`, `accounts`)
4. Use `FeaturesCompanion` for inserts/updates (allows partial updates)
5. Use `Value()` wrapper for optional Companion fields
6. Return `Future<void>` for write operations
7. Return `Stream<T>` for reactive queries

### After Creating DAO
1. Add DAO to `app_database.dart`:
```dart
@DriftDatabase(
  tables: [..., Features],
  daos: [..., FeaturesDao],
)
class AppDatabase extends _$AppDatabase {
  // Add getter
  FeaturesDao get featuresDao => FeaturesDao(this);
}
```

2. Add export to `daos/daos.dart`:
```dart
export 'features_dao.dart';
```

3. Run build_runner:
```bash
dart run build_runner build --delete-conflicting-outputs
```

